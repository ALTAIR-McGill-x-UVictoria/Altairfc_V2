#!/bin/bash
# NetworkManager dispatcher hook: force ZeroTier to rebind its UDP sockets
# immediately after a network/Wi-Fi change, instead of waiting on its own
# multi-minute path-detection timers. Needed on both the ground station
# and the flight computer Pi so SSH over ZeroTier comes back quickly after
# any wifi change.
#
# Deploy (on both machines running NetworkManager):
#   sudo install -m 755 -o root -g root 90-zerotier-reconnect \
#       /etc/NetworkManager/dispatcher.d/90-zerotier-reconnect
#   sudo ln -sf /etc/NetworkManager/dispatcher.d/90-zerotier-reconnect \
#       /etc/NetworkManager/dispatcher.d/no-wait.d/90-zerotier-reconnect
#
# The no-wait.d symlink keeps this from blocking other dispatcher scripts
# while zerotier-one restarts.
INTERFACE="$1"
ACTION="$2"

# Ignore events on ZeroTier's own tun interfaces to avoid restart loops.
case "$INTERFACE" in
    zt*) exit 0 ;;
esac

case "$ACTION" in
    up|down|dhcp4-change|dhcp6-change|vpn-up|vpn-down) ;;
    *) exit 0 ;;
esac

# A single network transition fires several of the events above in quick
# succession (down, up, dhcp4-change, ...). Restarting zerotier-one on each
# one overlaps the previous restart's shutdown and reliably crashes it
# (SIGABRT / "ioctl() failed setting up Linux tap device"). Debounce with a
# lock + cooldown so only one restart happens per network change.
LOCKFILE=/run/zerotier-reconnect.lock
MARKER=/run/zerotier-reconnect.last
COOLDOWN=10

exec 9>"$LOCKFILE"
flock -n 9 || exit 0

now=$(date +%s)
if [ -f "$MARKER" ] && [ $(( now - $(cat "$MARKER") )) -lt "$COOLDOWN" ]; then
    exit 0
fi
echo "$now" > "$MARKER"

systemctl restart zerotier-one.service
